# ─── SERVER ───────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MONGODB ──────────────────────────────
# Pata hii kutoka MongoDB Atlas → Connect → Drivers
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/maglasspro?retryWrites=true&w=majority

# ─── JWT ──────────────────────────────────
# Weka string ngumu hapa (herufi 32+), mfano: openssl rand -hex 32
JWT_SECRET=badilisha_hii_na_string_ngumu_sana_32chars_au_zaidi
JWT_EXPIRES_IN=7d

# ─── ADMIN CREDENTIALS (FIRST SETUP) ─────
# Hizi zinatumika kwenye seeding ya kwanza tu
ADMIN_USERNAME=admin
ADMIN_PASSWORD=MaglassPro@2025!

# ─── CLOUDINARY ───────────────────────────
# Pata kutoka cloudinary.com → Dashboard → API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── EMAIL (Gmail SMTP) ───────────────────
# Tumia Gmail yako. Nenda Google Account → Security → 2FA on → App Passwords → Generate
EMAIL_USER=your_gmail@gmail.com
EMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx
EMAIL_RECEIVER=studio@maglasspro.com

# ─── FRONTEND URL (kwa CORS) ──────────────
FRONTEND_URL=https://maglasspro.netlify.app
